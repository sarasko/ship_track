# ── General ──────────────────────────────────────────────────────────────────

NODE_ENV=development


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by: order-service, inventory-service
# Local:   connects to the ST_Postgres container
# Prod:    replace with your Supabase connection string

POSTGRES_DB=shiptrack
POSTGRES_USER=shiptrack_user
POSTGRES_PASSWORD=shiptrack_dev_password


# ── MongoDB ───────────────────────────────────────────────────────────────────
# Used by: order-service (product catalogue)
# Local:   connects to the ST_Mongo container
# Prod:    replace with your Atlas M0 connection string

MONGO_DB=shiptrack
MONGO_USER=shiptrack_user
MONGO_PASSWORD=shiptrack_dev_password
MONGO_HOST=changeme_to_your_mongo_host


# ── AWS / LocalStack ──────────────────────────────────────────────────────────
# Local:  AWS_ENDPOINT_URL points at LocalStack — SDK uses this automatically
# Prod:   remove AWS_ENDPOINT_URL entirely — SDK will use real AWS
#         AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should be real IAM keys in prod

AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=eu-west-1

# LocalStack accepts any non-empty value for credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack default account ID is 000000000000
# These ARNs/URLs are constructed from that — they work with localstack-init.sh as-is
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:shiptrack-events

SQS_ORDER_QUEUE_URL=http://localstack:4566/000000000000/order-events
SQS_INVENTORY_QUEUE_URL=http://localstack:4566/000000000000/inventory-events
SQS_NOTIFICATION_QUEUE_URL=http://localstack:4566/000000000000/notification-events

# Optional — only needed for LocalStack Pro features (not required for this project)
LOCALSTACK_AUTH_TOKEN=


# ── Auth ──────────────────────────────────────────────────────────────────────
# Used by: API gateway / order-service for JWT signing
# Change this to a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=change_me_to_a_random_32_byte_hex_string


# ── Email (Notification Service) ──────────────────────────────────────────────
# Local:  use Mailtrap free tier — sign up at mailtrap.io, copy SMTP credentials
# Prod:   replace with AWS SES or your preferred provider

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=shiptrack@example.com


# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite exposes env vars prefixed with VITE_ to the browser
# Points at the order-service / API gateway

VITE_API_URL=http://localhost:3001
